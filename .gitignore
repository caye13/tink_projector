.Trashes
ehthumbs.db
Thumbs.db
.directory
.AppleDouble
.LSOverride

# =========================
# IDE / editors
# =========================
# VS Code — keep shared settings, ignore everything else
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
# Uncomment to ignore all of .vscode:
# .vscode/

