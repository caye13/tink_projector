tags

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =========================
# TI / hardware vendor — optional
# =========================
# The DLP230NP support package is large (~60MB zip) and not needed for GUI-only work.
# GUI contributors should leave this uncommented. Hardware owners who want to version it
# can comment the next line out and `git add -f dlpdlcr230np_python_support_code/`.
dlpdlcr230np_python_support_code/
*.zip
# Keep the manifest HTML if you do track the package
# !dlpdlcr230np_python_support_code/**/*.py

# =========================
# Misc project cruft
# =========================
# Mise / tool version managers (opencode already uses these locally)
.mise.toml
# Secrets
.env.local
.env.*.local
*.pem
*.key

# Arduino build artifacts
arduino/**/build/
arduino/**/*.elf
arduino/**/*.hex
arduino/**/*.eep
