# =========================
# Project — media & runtime
# =========================
# User videos — don't commit personal media. Keep the folders with .gitkeep so they clone empty.
media/*
gui-media/*
# If you keep placeholder .gitkeep files, allow them:
!media/.gitkeep
!gui-media/.gitkeep

# Thumbnails are cached outside the repo (~/.cache/rasp-ui/thumbnails on Linux,
# ~/Library/Caches/rasp-ui/thumbnails on macOS). If a local cache ever appears, ignore it:
.cache/
thumbnails/
*.thumb.jpg

# OS-generated thumbnails
._*

